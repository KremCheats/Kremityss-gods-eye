{
  "expo": {
    "name": "Kremityss Live",
    "slug": "kremityss-live",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#07040f"
    },
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "scheme": "kremityss",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kremityss.godseye",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.kremityss.godseye"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "websiteUrl": "https://kremityss-gods-eye.manus.space"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
